# Copy to .env.local and fill in. Never commit real values.
# Local dev uses a file database automatically (./ammige.db).

# Admin panel password (change immediately after first login via Settings)
AMMIGE_ADMIN_PASSWORD=ammige123

# Secret used to sign admin session cookies (set a long random string in production)
ADMIN_SECRET=change-this-to-a-long-random-string

# --- Vercel / production database (Turso, free) ---
# On Vercel the local file DB does not persist, so set these:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Public site URL (used for sitemap + canonical URLs)
NEXT_PUBLIC_SITE_URL=https://ammige.com
